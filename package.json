{
  "name": "proactive-wellness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env apps/api/src/server.ts",
    "start": "node --env-file-if-exists=.env apps/api/src/server.ts",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/mobile/tsconfig.json",
    "mobile": "pnpm --dir apps/mobile start",
    "migrate": "node apps/api/src/migrate.ts",
    "format": "prettier --write apps packages scripts tests docs *.json *.yaml"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pg": "^8.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "lucide-react": "^0.468.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "prettier": "^3.6.0"
  }
}
