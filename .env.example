PORT=4173
HOST=127.0.0.1
NODE_ENV=development
# Optional PostgreSQL for local integration testing; otherwise SQLite is used.
# DATABASE_URL=postgresql://wellness:local-password@localhost:5432/wellness
# A 32-byte hexadecimal key. Without this, LOCAL mode creates data/.local-key.
# DATA_ENCRYPTION_KEY=
# Required settings for a future South African production deployment.
# HOSTING_REGION=af-south-1
# INFORMATION_OFFICER_EMAIL=
# PG_CA_FILE=
# Never place credentials in EXPO_PUBLIC_* variables.
